{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "target": "es2023",
    "lib": [
      "es2023",
      "dom"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "declaration": false,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@restAPI/*": [
        "src/apps/restAPI/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*",
  ],
  "exclude": [
    "node_modules",
    "./public",
    "dist",
  ]
}