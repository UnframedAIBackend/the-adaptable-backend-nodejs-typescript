# .dockerignore - Exclude files from Docker build context
# This reduces build context size and improves build performance

# Git directory and version control
.git
.gitignore
.gitattributes

# Node.js dependencies (will be installed in container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (will be generated in container)
dist
build
*.tsbuildinfo

# Development files
.vscode
.idea
.kiro
*.swp
*.swo
*~

# Test files
test
tests
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js
coverage
.nyc_output

# Documentation
README.md
CHANGELOG.md
LICENSE
*.md
docs

# Environment files (use ConfigMaps/Secrets in Kubernetes)
.env
.env.*
env.sample
.env.local
.env.development
.env.test
.env.production

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Docker files (not needed inside container)
Dockerfile
.dockerignore
docker-compose.yml
compose.yml

# CI/CD files
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Infrastructure and deployment files (not needed in app container)
infrastructure
Makefile
*.yaml
*.yml
!nest-cli.json

# Temporary files
tmp
temp
*.tmp
*.bak
*.cache

# IDE and editor files
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings

# Containers directory (MongoDB Dockerfile, not needed for app)
containers
